{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chinaszzt.github.io/goal-control/schemas/goal-manifest.schema.json",
  "title": "Goal control manifest",
  "description": "Versioned static Goal DAG. Mutable runtime state is deliberately excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "repository",
    "base_head",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "goal_id": {
      "$ref": "#/$defs/safeId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "mode": {
      "type": "string",
      "enum": [
        "shadow",
        "enforce"
      ],
      "default": "shadow"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name_with_owner",
        "base_branch"
      ],
      "properties": {
        "name_with_owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_branch": {
          "const": "main"
        },
        "merge_policy": {
          "type": "string",
          "enum": [
            "goalctl-github-squash-v1"
          ]
        }
      }
    },
    "base_head": {
      "$ref": "#/$defs/fullSha"
    },
    "preclaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "operation_id",
        "requested_at",
        "authorization",
        "issues",
        "expected_actor",
        "expected_status"
      ],
      "properties": {
        "policy": {
          "const": "supervisor-exact-whitelist-v1"
        },
        "operation_id": {
          "$ref": "#/$defs/safeId"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/repoPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "expected_actor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        },
        "expected_status": {
          "const": "status:doing"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "$ref": "#/$defs/repoPath"
        },
        "shared": {
          "$ref": "#/$defs/repoPath"
        },
        "foreman": {
          "$ref": "#/$defs/repoPath"
        },
        "captain": {
          "$ref": "#/$defs/repoPath"
        },
        "role_kernel": {
          "$ref": "#/$defs/repoPath"
        }
      }
    },
    "worker_canary_bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "policy"
      ],
      "properties": {
        "protocol": {
          "const": "goalctl-worker-canary-bootstrap-v1"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/repoPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "captain_canary_bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "policy"
      ],
      "properties": {
        "protocol": {
          "const": "goalctl-captain-canary-bootstrap-v1"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/repoPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 120
    },
    "fullSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repoPath": {
      "type": "string",
      "description": "Repository-relative POSIX path. The CLI additionally resolves realpath and rejects escape from the repository.",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "minLength": 1,
      "maxLength": 500
    },
    "packetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "path",
        "sha256"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "p1Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "artifact_root",
        "authority",
        "dependency_gate"
      ],
      "properties": {
        "producer": {
          "const": "CAPTAIN"
        },
        "artifact_root": {
          "$ref": "#/$defs/repoPath"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "SCOPED_DELEGATION"
            },
            "path": {
              "$ref": "#/$defs/repoPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "dependency_gate": {
          "const": "ARCHIVED"
        }
      }
    },
    "p1ExpectedWritePattern": {
      "type": "string",
      "description": "Mechanical-P1-only repository-relative POSIX pattern. Supports exact literals, * within one segment, and ** only as a whole segment.",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*//).+$",
      "allOf": [
        {
          "not": {
            "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "[\\\\\\u0000!?{}\\[\\]]"
          }
        },
        {
          "not": {
            "pattern": "[?*+@!]\\("
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)(?!\\*\\*(?:/|$))[^/]*\\*\\*[^/]*(?:/|$)"
          }
        }
      ]
    },
    "resourceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "access"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "PORT",
            "BROWSER_PROFILE",
            "ACCOUNT",
            "TIM_SESSION",
            "WINDOW",
            "EXECUTABLE",
            "TEST_DATA"
          ]
        },
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "access": {
          "type": "string",
          "enum": [
            "EXCLUSIVE",
            "SHARED_READ"
          ]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "DEV",
              "REVIEW",
              "RECEIPT"
            ]
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "p1"
            ]
          },
          "then": {
            "properties": {
              "expected_write_set": {
                "items": {
                  "$ref": "#/$defs/p1ExpectedWritePattern"
                }
              }
            }
          }
        }
      ],
      "required": [
        "id",
        "dependencies",
        "integration_order",
        "packet"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "issue": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "integration_order": {
          "type": "integer",
          "minimum": 1
        },
        "parallel_group": {
          "$ref": "#/$defs/safeId"
        },
        "risk_class": {
          "type": "string",
          "description": "Reviewed task risk label used by the Coordinator when selecting the gate profile.",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "minLength": 1,
          "maxLength": 80,
          "default": "STANDARD"
        },
        "packet": {
          "$ref": "#/$defs/packetRef"
        },
        "p1": {
          "$ref": "#/$defs/p1Policy"
        },
        "expected_write_set": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "conflict_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "resource_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceRequirement"
          }
        }
      }
    }
  }
}
