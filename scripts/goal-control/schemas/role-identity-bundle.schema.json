{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goal-control.local/schemas/role-identity-bundle.schema.json",
  "title": "Atomic role identity intent and probe challenge bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "operation_id",
    "semantic_slot_sha256",
    "intent",
    "challenge",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "ROLE_IDENTITY_CHALLENGE_BUNDLE" },
    "operation_id": { "$ref": "#/$defs/controllerId" },
    "semantic_slot_sha256": { "$ref": "#/$defs/sha256" },
    "intent": {
      "$ref": "https://goal-control.local/schemas/role-identity-intent.schema.json"
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "goal_id",
        "task_id",
        "role",
        "thread_id",
        "host_id",
        "attempt",
        "registration_event_id",
        "canary_plan_sha256",
        "producer_namespace",
        "issuer_capability_sha256",
        "attestation_algorithm",
        "attestation_key_id",
        "attestation_public_key_sha256",
        "challenge",
        "issued_at",
        "expires_at",
        "record_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "PROBE_OBSERVATION_CHALLENGE" },
        "goal_id": { "$ref": "#/$defs/controllerId" },
        "task_id": { "$ref": "#/$defs/controllerId" },
        "role": { "$ref": "#/$defs/role" },
        "thread_id": { "$ref": "#/$defs/platformUuid" },
        "host_id": { "$ref": "#/$defs/platformUuid" },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "registration_event_id": { "$ref": "#/$defs/controllerId" },
        "canary_plan_sha256": { "$ref": "#/$defs/sha256" },
        "producer_namespace": {
          "enum": ["HOST_ADAPTER", "ISOLATED_TEST_FAKE"]
        },
        "issuer_capability_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attestation_algorithm": { "const": "ED25519" },
        "attestation_key_id": { "$ref": "#/$defs/controllerId" },
        "attestation_public_key_sha256": { "$ref": "#/$defs/sha256" },
        "challenge": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issued_at": { "$ref": "#/$defs/canonicalTimestamp" },
        "expires_at": { "$ref": "#/$defs/canonicalTimestamp" },
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bundle_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "controllerId": {
      "$ref": "https://goal-control.local/schemas/role-identity-intent.schema.json#/$defs/safeId"
    },
    "platformUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "role": {
      "enum": ["FOREMAN", "CAPTAIN", "DEV", "REVIEW", "RECEIPT"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonicalTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
