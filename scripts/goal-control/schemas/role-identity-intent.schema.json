{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goal-control.local/schemas/role-identity-intent.schema.json",
  "title": "Controller-derived durable role identity intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "protocol",
    "operation_id",
    "semantic_slot_sha256",
    "goal_id",
    "task_id",
    "role",
    "thread_id",
    "host_id",
    "attempt",
    "session_id",
    "launch_id",
    "state_revision",
    "control_epoch",
    "packet",
    "base_head",
    "full_head",
    "task_cycle",
    "worker_bootstrap",
    "worker_bootstrap_authority",
    "identity_observation",
    "issuer_authority",
    "created_at",
    "intent_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "ROLE_IDENTITY_INTENT" },
    "protocol": { "const": "goalctl-role-identity-intent-v2" },
    "operation_id": { "$ref": "#/$defs/safeId" },
    "semantic_slot_sha256": { "$ref": "#/$defs/sha256" },
    "goal_id": { "$ref": "#/$defs/safeId" },
    "task_id": { "$ref": "#/$defs/safeId" },
    "role": { "$ref": "#/$defs/role" },
    "thread_id": { "$ref": "#/$defs/platformUuid" },
    "host_id": { "$ref": "#/$defs/platformUuid" },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "session_id": { "$ref": "#/$defs/platformUuid" },
    "launch_id": {
      "oneOf": [
        { "$ref": "#/$defs/safeId" },
        { "type": "null" }
      ]
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "control_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sha256"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "base_head": { "$ref": "#/$defs/fullSha" },
    "full_head": { "$ref": "#/$defs/fullSha" },
    "task_cycle": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "worker_bootstrap": {
      "oneOf": [
        { "$ref": "#/$defs/workerBootstrapBinding" },
        { "type": "null" }
      ]
    },
    "worker_bootstrap_authority": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt_content_sha256",
            "receipt_file_identity_sha256",
            "intent_content_sha256",
            "intent_file_identity_sha256"
          ],
          "properties": {
            "receipt_content_sha256": { "$ref": "#/$defs/sha256" },
            "receipt_file_identity_sha256": { "$ref": "#/$defs/sha256" },
            "intent_content_sha256": { "$ref": "#/$defs/sha256" },
            "intent_file_identity_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        { "type": "null" }
      ]
    },
    "identity_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_sha256",
        "receipt_file_identity_sha256",
        "record_sha256",
        "attestation_key_id",
        "observed_at",
        "expires_at",
        "worker_bootstrap_binding_sha256",
        "signed_record"
      ],
      "properties": {
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_file_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "record_sha256": { "$ref": "#/$defs/sha256" },
        "attestation_key_id": { "$ref": "#/$defs/safeId" },
        "observed_at": { "$ref": "#/$defs/canonicalTimestamp" },
        "expires_at": { "$ref": "#/$defs/canonicalTimestamp" },
        "worker_bootstrap_binding_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "signed_record": {
          "$ref": "https://goal-control.local/schemas/role-identity-observation.schema.json"
        }
      }
    },
    "issuer_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capability_sha256",
        "capability_file_identity_sha256",
        "source_task_id",
        "role",
        "thread_id",
        "host_id",
        "attempt",
        "session_id",
        "lease_until",
        "registration_event_id",
        "bootstrap_init_receipt_sha256",
        "recovery_scope_sha256"
      ],
      "properties": {
        "kind": {
          "enum": ["BOOTSTRAP", "SESSION", "CURRENT_SESSION", "GOAL_RECOVERY"]
        },
        "capability_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capability_file_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_task_id": {
          "oneOf": [
            { "$ref": "#/$defs/safeId" },
            { "type": "null" }
          ]
        },
        "role": {
          "oneOf": [
            { "$ref": "#/$defs/role" },
            { "type": "null" }
          ]
        },
        "thread_id": {
          "oneOf": [
            { "$ref": "#/$defs/platformUuid" },
            { "type": "null" }
          ]
        },
        "host_id": {
          "oneOf": [
            { "$ref": "#/$defs/platformUuid" },
            { "type": "null" }
          ]
        },
        "attempt": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            { "type": "null" }
          ]
        },
        "session_id": {
          "oneOf": [
            { "$ref": "#/$defs/platformUuid" },
            { "type": "null" }
          ]
        },
        "lease_until": {
          "oneOf": [
            { "$ref": "#/$defs/canonicalTimestamp" },
            { "type": "null" }
          ]
        },
        "registration_event_id": {
          "oneOf": [
            { "$ref": "#/$defs/safeId" },
            { "type": "null" }
          ]
        },
        "bootstrap_init_receipt_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "recovery_scope_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "BOOTSTRAP" },
            "source_task_id": { "type": "null" },
            "role": { "type": "null" },
            "thread_id": { "type": "null" },
            "host_id": { "type": "null" },
            "attempt": { "type": "null" },
            "session_id": { "type": "null" },
            "lease_until": { "type": "null" },
            "registration_event_id": { "type": "null" },
            "bootstrap_init_receipt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "recovery_scope_sha256": { "type": "null" }
          }
        },
        {
          "properties": {
            "kind": { "enum": ["SESSION", "CURRENT_SESSION"] },
            "source_task_id": { "$ref": "#/$defs/safeId" },
            "role": { "$ref": "#/$defs/role" },
            "thread_id": { "$ref": "#/$defs/platformUuid" },
            "host_id": { "$ref": "#/$defs/platformUuid" },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "session_id": { "$ref": "#/$defs/platformUuid" },
            "lease_until": { "$ref": "#/$defs/canonicalTimestamp" },
            "registration_event_id": { "$ref": "#/$defs/safeId" },
            "bootstrap_init_receipt_sha256": { "type": "null" },
            "recovery_scope_sha256": { "type": "null" }
          }
        },
        {
          "properties": {
            "kind": { "const": "GOAL_RECOVERY" },
            "source_task_id": { "$ref": "#/$defs/safeId" },
            "role": { "const": "FOREMAN" },
            "thread_id": { "$ref": "#/$defs/platformUuid" },
            "host_id": { "$ref": "#/$defs/platformUuid" },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "session_id": { "$ref": "#/$defs/platformUuid" },
            "lease_until": { "$ref": "#/$defs/canonicalTimestamp" },
            "registration_event_id": { "$ref": "#/$defs/safeId" },
            "bootstrap_init_receipt_sha256": { "type": "null" },
            "recovery_scope_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "created_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "intent_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": { "enum": ["DEV", "REVIEW", "RECEIPT"] }
        },
        "required": ["role"]
      },
      "then": {
        "properties": {
          "launch_id": { "$ref": "#/$defs/safeId" },
          "worker_bootstrap": {
            "$ref": "#/$defs/workerBootstrapBinding"
          }
          ,
          "worker_bootstrap_authority": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "launch_id": { "type": "null" },
          "worker_bootstrap": { "type": "null" },
          "worker_bootstrap_authority": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "issuer_authority": {
            "type": "object",
            "properties": { "kind": { "const": "BOOTSTRAP" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": { "role": { "const": "FOREMAN" } }
      }
    },
    {
      "if": {
        "properties": {
          "issuer_authority": {
            "type": "object",
            "properties": { "kind": { "const": "GOAL_RECOVERY" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": { "role": { "const": "FOREMAN" } }
      }
    },
    {
      "if": {
        "properties": {
          "role": { "enum": ["FOREMAN", "CAPTAIN"] },
          "issuer_authority": {
            "type": "object",
            "properties": {
              "kind": { "const": "SESSION" }
            },
            "required": ["kind"]
          }
        },
        "required": ["role", "issuer_authority"]
      },
      "then": {
        "properties": {
          "issuer_authority": {
            "type": "object",
            "properties": { "role": { "const": "FOREMAN" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": { "enum": ["DEV", "REVIEW", "RECEIPT"] },
          "issuer_authority": {
            "properties": { "kind": { "const": "SESSION" } },
            "required": ["kind"]
          }
        },
        "required": ["role", "issuer_authority"]
      },
      "then": {
        "properties": {
          "issuer_authority": {
            "properties": { "role": { "const": "CAPTAIN" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "issuer_authority": {
            "properties": { "kind": { "const": "CURRENT_SESSION" } },
            "required": ["kind"]
          }
        },
        "required": ["issuer_authority"]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "role": { "const": "FOREMAN" },
              "issuer_authority": {
                "properties": { "role": { "const": "FOREMAN" } }
              }
            }
          },
          {
            "properties": {
              "role": { "const": "CAPTAIN" },
              "issuer_authority": {
                "properties": { "role": { "const": "CAPTAIN" } }
              }
            }
          },
          {
            "properties": {
              "role": { "const": "DEV" },
              "issuer_authority": {
                "properties": { "role": { "const": "DEV" } }
              }
            }
          },
          {
            "properties": {
              "role": { "const": "REVIEW" },
              "issuer_authority": {
                "properties": { "role": { "const": "REVIEW" } }
              }
            }
          },
          {
            "properties": {
              "role": { "const": "RECEIPT" },
              "issuer_authority": {
                "properties": { "role": { "const": "RECEIPT" } }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "allOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        {
          "not": {
            "pattern": "(?:^|[^A-Za-z0-9_-])[A-Za-z0-9_-]{43}(?:$|[^A-Za-z0-9_-])"
          }
        },
        {
          "not": {
            "pattern": "(?:[gG][hH][pPoOuUsSrR][_-][A-Za-z0-9_-]{8,}|[gG][iI][tT][hH][uU][bB][_-][pP][aA][tT][_-][A-Za-z0-9_-]{8,}|[xX][oO][xX][bBaApPrRsS][_-][A-Za-z0-9_-]{8,})"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[^A-Za-z0-9])(?:(?:(?:[sS][kK]|[pP][kK]|[rR][kK]|[aA][pP][iI]|[aA][uU][tT][hH]|[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[bB][eE][aA][rR][eE][rR]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[aA][cC][cC][eE][sS][sS][_-]?[kK][eE][yY])[_-](?:[lL][iI][vV][eE]|[tT][eE][sS][tT]|[pP][rR][oO][dD]|[pP][rR][oO][jJ]|[kK][eE][yY])?[_-]?)[A-Za-z0-9_-]{8,})(?:$|[^A-Za-z0-9])"
          }
        },
        {
          "not": {
            "pattern": "^(?:AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{20,}|npm_[A-Za-z0-9]{16,}|pypi-[A-Za-z0-9_-]{16,}|eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})$"
          }
        },
        {
          "not": {
            "pattern": "(?:[gG][lL][pP][aA][tT]-[A-Za-z0-9_-]{8,}|[hH][fF]_[A-Za-z0-9_-]{8,}|[xX][aA][iI]-[A-Za-z0-9_-]{8,}|[sS][kK][0-9a-fA-F]{32}|[sS][gG]\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})"
          }
        }
      ]
    },
    "platformUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "canonicalTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "role": {
      "enum": ["FOREMAN", "CAPTAIN", "DEV", "REVIEW", "RECEIPT"]
    },
    "fullSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workerBootstrapBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol",
        "receipt_file",
        "receipt_sha256",
        "identity_plan_sha256",
        "identity_observation_sha256",
        "operation_id",
        "challenge",
        "thread",
        "host",
        "worktree",
        "git_dir",
        "common_git_dir",
        "head",
        "branch",
        "canary_policy",
        "binding_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "protocol": {
          "const": "goalctl-worker-canary-bootstrap-v1"
        },
        "receipt_file": { "$ref": "#/$defs/absolutePath" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "identity_plan_sha256": { "$ref": "#/$defs/sha256" },
        "identity_observation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "operation_id": { "$ref": "#/$defs/safeId" },
        "challenge": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "thread": { "$ref": "#/$defs/platformUuid" },
        "host": { "$ref": "#/$defs/platformUuid" },
        "worktree": { "$ref": "#/$defs/absolutePath" },
        "git_dir": { "$ref": "#/$defs/absolutePath" },
        "common_git_dir": { "$ref": "#/$defs/absolutePath" },
        "head": { "$ref": "#/$defs/fullSha" },
        "branch": {
          "type": "string",
          "pattern": "^codex/.+",
          "maxLength": 300,
          "allOf": [
            { "$ref": "#/$defs/nonSensitiveString" }
          ]
        },
        "canary_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "^/" },
              "allOf": [
                { "$ref": "#/$defs/nonSensitiveString" }
              ]
            },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "binding_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nonSensitiveString": {
      "type": "string",
      "allOf": [
        {
          "not": {
            "pattern": "(?:^|[^A-Za-z0-9_-])[A-Za-z0-9_-]{43}(?:$|[^A-Za-z0-9_-])"
          }
        },
        {
          "not": {
            "pattern": "(?:[gG][hH][pPoOuUsSrR][_-][A-Za-z0-9_-]{8,}|[gG][iI][tT][hH][uU][bB][_-][pP][aA][tT][_-][A-Za-z0-9_-]{8,}|[xX][oO][xX][bBaApPrRsS][_-][A-Za-z0-9_-]{8,}|[gG][lL][pP][aA][tT]-[A-Za-z0-9_-]{8,}|[hH][fF]_[A-Za-z0-9_-]{8,}|[xX][aA][iI]-[A-Za-z0-9_-]{8,}|[sS][kK][0-9a-fA-F]{32}|[sS][gG]\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[^A-Za-z0-9])(?:(?:[sS][kK]|[pP][kK]|[rR][kK]|[aA][pP][iI]|[aA][uU][tT][hH]|[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[bB][eE][aA][rR][eE][rR]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[aA][cC][cC][eE][sS][sS][_-]?[kK][eE][yY])[_-](?:[lL][iI][vV][eE]|[tT][eE][sS][tT]|[pP][rR][oO][dD]|[pP][rR][oO][jJ]|[kK][eE][yY])?[_-]?[A-Za-z0-9_-]{8,})(?:$|[^A-Za-z0-9])"
          }
        },
        {
          "not": {
            "pattern": "(?:[aA][pP][iI][_-]?[kK][eE][yY]|[pP][aA][sS][sS](?:[wW][oO][rR][dD]|[wW][dD])|[cC][lL][iI][eE][nN][tT][_-]?[sS][eE][cC][rR][eE][tT]|[pP][rR][iI][vV][aA][tT][eE][_-]?[kK][eE][yY]|[aA][cC][cC][eE][sS][sS][_-]?(?:[tT][oO][kK][eE][nN]|[kK][eE][yY])|[tT][oO][kK][eE][nN]|[aA][uU][tT][hH](?:[oO][rR][iI][zZ][aA][tT][iI][oO][nN])?|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL])\\s*[:=]\\s*[^\\s\"'&]{4,}"
          }
        },
        {
          "not": {
            "pattern": "-----BEGIN (?:[A-Za-z0-9 ]+ )?PRIVATE KEY-----"
          }
        },
        {
          "not": {
            "pattern": "(?:[bB][aA][sS][iI][cC]|[bB][eE][aA][rR][eE][rR])\\s+[A-Za-z0-9._~+/-]+=*"
          }
        },
        {
          "not": {
            "pattern": "https?://(?:[^/\\s@]+@|[^\\s\"']+[?&](?:[aA][cC][cC][eE][sS][sS][_-]?[tT][oO][kK][eE][nN]|[aA][pP][iI][_-]?[kK][eE][yY]|[pP][aA][sS][sS](?:[wW][oO][rR][dD]|[wW][dD])|[cC][lL][iI][eE][nN][tT][_-]?[sS][eE][cC][rR][eE][tT]|[pP][rR][iI][vV][aA][tT][eE][_-]?[kK][eE][yY]|[tT][oO][kK][eE][nN]|[kK][eE][yY]|[sS][eE][cC][rR][eE][tT]|[aA][uU][tT][hH](?:[oO][rR][iI][zZ][aA][tT][iI][oO][nN])?|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL])=)"
          }
        }
      ]
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/",
      "allOf": [
        { "$ref": "#/$defs/nonSensitiveString" }
      ]
    }
  }
}
