{
  "name": "@chinaszzt/goal-control",
  "version": "0.1.0",
  "private": true,
  "description": "Crash-safe, append-only control plane for multi-session software delivery.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "goalctl": "scripts/goalctl.js",
    "resourcectl": "scripts/resourcectl.js"
  },
  "scripts": {
    "goalctl": "node scripts/goalctl.js",
    "resourcectl": "node scripts/resourcectl.js",
    "test": "pnpm test:full",
    "test:fast": "TZ=Asia/Shanghai NODE_OPTIONS=--experimental-vm-modules jest --runInBand __tests__/extractionProvenance.test.ts __tests__/goalControlArchiveFinality.test.ts __tests__/goalControlCanaryBootstrapArtifacts.test.ts __tests__/goalControlGenerationBoundaryHooks.test.ts __tests__/goalControlRecoveryLeaseGate.test.ts __tests__/goalControlRuntimeRotation.test.ts __tests__/goalControlSchema.test.ts __tests__/goalControlTransactionCoverage.test.ts",
    "test:binding": "TZ=Asia/Shanghai NODE_OPTIONS=--experimental-vm-modules jest --runInBand __tests__/goalControlPreflight.test.ts -t \"opt-in worker registration|sibling checkout|receipt binding\"",
    "test:l1": "TZ=Asia/Shanghai NODE_OPTIONS=--experimental-vm-modules jest --runInBand __tests__/goalControlAtomicCrashBoundary.test.ts __tests__/goalControlConcurrency.test.ts __tests__/goalControlWorktreeBootstrapFilesHeadTransaction.test.ts __tests__/goalControlWorktreeBootstrapHeadTransaction.test.ts",
    "test:lab": "node lab/run-scenario.js",
    "test:full": "TZ=Asia/Shanghai NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "check": "pnpm verify:provenance && pnpm test:fast && pnpm test:binding && pnpm test:lab",
    "provenance:create": "node scripts/create-extraction-provenance.js",
    "verify:provenance": "node scripts/verify-extraction-provenance.js",
    "verify:source": "node scripts/verify-source-equivalence.js"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "jest": "30.3.0",
    "ts-jest": "29.4.6",
    "typescript": "~5.9.2"
  }
}
